<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <AssemblyTitle>Penumbra.Api</AssemblyTitle>
        <Product>Penumbra</Product>
        <Copyright>Copyright © 2025</Copyright>
        <FileVersion>5.20.0.0</FileVersion>
        <AssemblyVersion>5.20.0.0</AssemblyVersion>
        <PackageVersion>5.20.0</PackageVersion>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <OutputPath>bin\$(Configuration)\</OutputPath>
        <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
    </PropertyGroup>

    <PropertyGroup>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Title>Penumbra.Api</Title>
        <Authors>Ottermandias</Authors>
        <RepositoryUrl>https://github.com/Ottermandias/Penumbra.Api</RepositoryUrl>
        <Description>Auxiliary functions for Penumbras external API.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <Use_DalamudPackager>false</Use_DalamudPackager>
        <Use_Dalamud_ImGui>false</Use_Dalamud_ImGui>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0" />
        <PackageReference Include="System.IO.Hashing" Version="9.0.8" />
        <ProjectReference Include="..\Luna\Luna.Generators\Luna.Generators.csproj" OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" PrivateAssets="all" />
        <ProjectReference Include="..\Luna\Luna\Luna.csproj" PrivateAssets="all" />
    </ItemGroup>

    <PropertyGroup>
        <LunaProjectPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Luna\Luna\Luna.csproj'))</LunaProjectPath>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeLunaFallback</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <None Include="buildTransitive\Penumbra.Api.targets" Pack="true" PackagePath="buildTransitive\Penumbra.Api.targets" />
    </ItemGroup>

    <Target Name="IncludeLunaFallback" DependsOnTargets="BuildOnlySettings;ResolveReferences">
        <ItemGroup>
            <_LunaOutput Include="@(ReferenceCopyLocalPaths)"
                         Condition="'%(ReferenceCopyLocalPaths.MSBuildSourceProjectFile)' == '$(LunaProjectPath)' And '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
            <TfmSpecificPackageFile Include="@(_LunaOutput)">
                <PackagePath>fallback/$(TargetFramework)/%(Filename)%(Extension)</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <NoWarn>1591;NU5100</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>
</Project>
